# Banco PostgreSQL (Supabase, Neon, Railway, Render... qualquer Postgres)
DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Endereço público do site (sem barra no final)
SITE_URL=http://localhost:3000

# Segredo para as sessões do painel (gere um texto aleatório longo)
AUTH_SECRET=troque-por-um-texto-aleatorio-com-mais-de-32-caracteres

# Primeiro acesso ao painel admin (criado pelo npm run db:setup)
ADMIN_EMAIL=admin@ldzstudio.com.br
ADMIN_PASSWORD=troque-esta-senha

# Mercado Pago (opcional): Pix, cartão e boleto automáticos
# Pegue em https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
